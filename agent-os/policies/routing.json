  "tag_specialists": {
    "security": {
      "role": "security-engineer",
      "from_level": 3,
      "reason": "touches a security-sensitive area (auth, vault, payments, CSP or secrets)"
    },
    "user_facing": {
      "role": "responsive-design-specialist",
      "from_level": 2,
      "reason": "user-facing change: the rendered UI must be inspected at representative widths in ar (RTL) and en"
    },
    "visual": {
      "role": "art-director",
      "from_level": 3,
      "reason": "changes shared visual language (tokens, typography, icons, spacing)"
    },
    "data": {
      "role": "database-architect",
      "from_level": 3,
      "reason": "changes persisted data or its schema"
    },
    "seo": {
      "role": "technical-seo-specialist",
      "from_level": 3,
      "reason": "changes routes, metadata or indexability"
    },
    "payments": {
      "role": "qa-lead",
      "from_level": 3,
      "reason": "payment flow: regression of checkout → delivery is mandatory"
    },
    "migration": {
      "role": "security-engineer",
      "from_level": 3,
      "reason": "migration scripts can touch legacy customer secrets"
    }
  },
  "level_requirements": {
    "1": {
      "workflow": "Inspect → Analyze → Report",
      "independent_review": false,
      "qa": false
    },
    "2": {
      "workflow": "Understand → Implement → Test → Verify",
      "independent_review": false,
      "qa": false
    },
    "3": {
      "workflow": "Impact review → Implement → Independent review → Tests → Relevant regression",
      "independent_review": true,
      "qa": false
    },
    "4": {
      "workflow": "Cross-domain impact → Plan → Relevant reviews → Implement → Independent validation → Regression",
      "independent_review": true,
      "qa": true,
      "second_manager": true
    },
    "5": {
      "workflow": "Decision record → Specialists → Risk review → Explicit approval → Controlled implementation → Security → QA → Full regression → Release gate",
      "independent_review": true,
      "qa": true,
      "second_manager": true,
      "consensus": true
    }
  },
  "executors": {
    "$comment": "How a routed role runs. `main` = the primary session. `subagent:<name>` = .claude/agents/<name>.md with restricted tools. Any role routed as a REVIEWER runs in a fresh context: its own subagent if it has one, otherwise subagent:independent-reviewer — never `main`, so a review is never a self-review.",
    "security-engineer": "subagent:security-reviewer",
    "art-director": "subagent:art-director",
    "competitor-intelligence-analyst": "subagent:research-analyst",
    "market-research-analyst": "subagent:research-analyst",
    "embedded-product-engineer": "subagent:embedded-product-engineer",
    "product-opportunity-lead": "main",
    "product-growth-analyst": "subagent:research-analyst",
    "qa-lead": "subagent:independent-reviewer",
    "default": "main",
    "responsive-design-specialist": "subagent:visual-qa",
    "accessibility-specialist": "subagent:visual-qa",
    "rtl-localization-specialist": "subagent:visual-qa",
    "product-ui-designer": "subagent:product-designer",
    "technical-seo-specialist": "subagent:independent-reviewer"
  },
  "type_overrides": {
    "research": {
      "team": ["competitor-intelligence-analyst"],
      "max_level": 1
    },
    "audit": {
      "team": ["qa-lead"],
      "max_level": 1
    },
    "opportunity_shaping": {
      "team": ["product-opportunity-lead", "embedded-product-engineer"],
      "add_if_user_facing": ["product-ui-designer"],
      "add_if_visual": ["art-director"],
      "max_level": 1
    }
  },
  "independent_reviewer_role": "qa-lead",
  "reviewer_executor_default": "subagent:independent-reviewer"
}
