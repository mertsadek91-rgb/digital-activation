{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release",
  "description": "A deployment to an environment.",
  "type": "object",
  "required": ["id", "title", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REL-\\d{4}$"
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "updated_at": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "status": {
      "$ref": "enums.json#/release_status"
    },
    "environment": {
      "type": ["string", "null"]
    },
    "tasks": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "pattern": "^(TASK|BUG|CR|DEC|CONSENSUS|EPIC|MILESTONE|OPP|SIG|INS|REL)-\\d{4}$"
      }
    },
    "released_at": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "rollback": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
