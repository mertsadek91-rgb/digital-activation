// ---------------------------------------------------------------------------
// System: settings, webhook idempotency, request idempotency, migration map.
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// Every provider webhook is recorded before it is acted on. Stripe and PayPal
/// both retry, and a licence key must not be issued twice for one payment.
model WebhookEvent {
  id                String          @id @default(cuid())
  provider          PaymentProvider
  /// Provider event id. The unique constraint is the idempotency guarantee.
  eventId           String
  type              String
  payload           Json
  signatureVerified Boolean         @default(false)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  error       String?

  @@unique([provider, eventId])
  @@index([processedAt])
  @@schema("public")
}

/// Client-supplied idempotency keys for mutating storefront endpoints, so a
/// double-tapped "pay" button creates one order rather than two.
model IdempotencyKey {
  key          String   @id
  scope        String
  /// Hash of the stored response, replayed on a repeat request.
  responseHash String?
  response     Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@schema("public")
}

/// Maps every legacy WordPress row to its new id. Written by the migration and
/// kept afterwards: it is what lets us generate the 301 map, re-run a partial
/// import safely, and answer "which product was post 10765?".
model LegacyMap {
  id         String   @id @default(cuid())
  /// "product" | "product_cat" | "product_tag" | "page" | "post" | "attachment"
  /// | "customer" | "order" | "coupon" | "license_code"
  legacyType String
  legacyId   String
  legacyUrl  String?
  entity     String
  entityId   String
  importedAt DateTime @default(now())

  @@unique([legacyType, legacyId])
  @@index([entity, entityId])
  @@index([legacyUrl])
  @@schema("public")
}

// --- first-party analytics (TASK-0096) ----------------------------------------

/// What the storefront records about browsing. The commerce half of the funnel
/// (carts, checkout, payment, delivery) is already in its own tables and is
/// deliberately not copied here.
enum AnalyticsEventType {
  PRODUCT_VIEW
  CATEGORY_VIEW
  WHATSAPP_CLICK
  CART_VIEW

  @@schema("public")
}

/// One browsing event, written by the API (`apps/api/src/analytics/`), fed by
/// the storefront's server. No browser script and no cookie.
///
/// Holds no personal data by construction: no email, name or IP. The
/// referrer is reduced to its host before it is stored, the path carries no
/// query string, and `visitorId` is a keyed hash of IP + user agent that
/// rotates every UTC day, so a visitor can be counted within a day but not
/// followed across days. Rows older than 13 months are pruned daily
/// (`AnalyticsPruneService`). `productId` / `categoryId` are plain ids with no
/// foreign key: an event must never stand in the way of deleting a product.
model AnalyticsEvent {
  id           String             @id @default(cuid())
  type         AnalyticsEventType
  /// Storefront path without query string or fragment.
  path         String
  productId    String?
  categoryId   String?
  /// Where a WhatsApp click came from (fab, header, product_question, ...).
  placement    String?
  locale       Locale
  /// Host only, never the full URL: a referrer URL can carry tokens.
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  /// Daily-rotating HMAC of IP + user agent; null when the caller sent no address.
  visitorId    String?
  createdAt    DateTime           @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@schema("public")
}

/// The random salt the day's analytics `visitorId`s are made with (TASK-0097).
///
/// One row per UTC day, created on first use by whichever API replica gets
/// there first (an insert that ignores a conflict, then a read). The
/// `visitorId` is HMAC(salt, IP + user agent), so it depends on nothing else:
/// no deployment secret can recreate it. Salts older than the current UTC day
/// are deleted by the daily `AnalyticsPruneService` sweep, after which that
/// day's ids can no longer be linked back to an address by anyone.
model AnalyticsSalt {
  /// The UTC day this salt is for.
  day       DateTime @id @db.Date
  /// 32 random bytes.
  salt      Bytes
  createdAt DateTime @default(now())

  @@schema("public")
}
