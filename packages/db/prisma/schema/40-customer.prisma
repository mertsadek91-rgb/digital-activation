// ---------------------------------------------------------------------------
// Customers, staff, sessions, audit.
//
// 218 legacy WordPress users migrate as Customer rows, but no password hash
// comes with them — everyone resets on first login. Staff accounts are created
// fresh and 2FA is not optional for any of them.
// ---------------------------------------------------------------------------

model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  phone           String?
  /// Argon2id. Null for customers migrated from WordPress and for guests who
  /// only ever checked out — they set one via the reset flow.
  passwordHash    String?

  firstName String?
  lastName  String?
  company   String?
  /// Captured for B2B invoices; drives VAT treatment on GCC/EU sales.
  vatNumber String?

  locale   Locale         @default(AR)
  /// Display currency preference. Money is still stored in USD everywhere.
  currency String         @default("USD")
  group    CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId  String?

  /// Aggregates refreshed on order transitions; used for segments and for the
  /// manager's view of an abandoned cart ("is this a repeat buyer?").
  totalSpentUsd Decimal   @default(0) @db.Decimal(12, 2)
  orderCount    Int       @default(0)
  lastOrderAt   DateTime?

  riskLevel         RiskLevel @default(LOW)
  /// Explicit marketing consent, with the timestamp. Transactional mail does
  /// not depend on it; campaigns and push do.
  marketingOptInAt  DateTime?
  marketingOptOutAt DateTime?

  /// The number WhatsApp messages go to, in E.164 (+9665XXXXXXXX). Separate
  /// from `phone` because consent attaches to a number: a customer can give a
  /// work phone for invoices and a personal one for WhatsApp.
  whatsappPhone    String?
  /// WhatsApp consent is its own channel under the PDPL and under Meta's
  /// policy — email consent does not carry over. Replying STOP clears the
  /// opt-in and stamps the opt-out, the same pair as email.
  whatsappOptInAt  DateTime?
  whatsappOptOutAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  addresses       CustomerAddress[]
  sessions        CustomerSession[]
  loginTokens     CustomerLoginToken[]
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  reviewInvites   ReviewInvite[]
  pushSubs        PushSubscription[]
  stockAlerts     StockAlert[]
  loyalty         LoyaltyAccount?
  referral        Referral?
  notifications   NotificationLog[]
  contactMessages ContactMessage[]
  promotions      Promotion[]          @relation("PromotionIssuedTo")
  promotionUses   PromotionUsage[]

  @@index([groupId])
  @@index([lastOrderAt])
  /// STOP arrives as a phone number, not a customer id.
  @@index([whatsappPhone])
  @@schema("public")
}

model CustomerGroup {
  id                  String            @id @default(cuid())
  kind                CustomerGroupKind @default(RETAIL)
  name                String            @unique
  /// Blanket discount for the group, applied before coupons.
  discountPercent     Decimal           @default(0) @db.Decimal(5, 2)
  /// B2B groups may pay by bank transfer against an invoice.
  allowInvoicePayment Boolean           @default(false)
  createdAt           DateTime          @default(now())

  customers Customer[]

  @@schema("public")
}

/// Digital goods still need a billing address: Stripe requires it for 3DS and
/// tax rules for GCC/EU digital services depend on the buyer's country.
model CustomerAddress {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  isDefault  Boolean  @default(false)

  fullName   String
  company    String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String /// ISO 3166-1 alpha-2
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@schema("public")
}

/// A single-use sign-in link, emailed to the address on the order.
///
/// There is no customer password in this flow and that is deliberate. Every
/// order here is a guest order, the 218 migrated WordPress customers arrived
/// with no hash, and the licence was delivered to this mailbox in the first
/// place — so control of the mailbox is exactly the bar that already handed
/// the key over. A password would add a secret to steal without raising that
/// bar. (`Customer.passwordHash` stays in the schema for a future portal that
/// needs more than reading licences.)
///
/// Only the hash is stored, so a database read cannot mint a link. Fifteen
/// minutes, one use, and the row is kept after use as the record that the
/// link was redeemed.
model CustomerLoginToken {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  tokenHash  String    @unique
  /// Where the request came from, so a burst is traceable.
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@schema("public")
}

/// Refresh-token sessions. Only the hash is stored, so a database read cannot
/// mint a token. Listed in the customer portal so a device can be revoked.
model CustomerSession {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([customerId, revokedAt])
  @@schema("public")
}

// --- staff ------------------------------------------------------------------

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole @default(READONLY)

  /// Set when an account is created or reset by pnpm db:staff, which prints
  /// the generated password to a terminal. A password that has been on a
  /// screen is not the owner's password yet, so the session is issued but
  /// every route except "change my password" refuses until this clears.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  /// TOTP is mandatory: the API refuses privileged routes while
  /// totpEnabledAt is null. Secret is encrypted at the application layer.
  totpSecret    Bytes?
  totpEnabledAt DateTime?
  /// The last TOTP time step accepted for this account. A code is valid for
  /// its whole ~90-second window, so without this a code seen once (over a
  /// shoulder, in a proxy log) could be replayed until it expired.
  totpLastStep  Int?
  /// Optional CIDR allowlist for admin access.
  ipAllowlist   String[]

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions        StaffSession[]
  auditLogs       AuditLog[]
  orderNotes      OrderNote[]
  contactMessages ContactMessage[]
  promotions      Promotion[]      @relation("PromotionCreatedBy")
  pageEdits       PageVersion[]
  articles        Article[]
  redirects       Redirect[]

  @@schema("public")
}

model StaffSession {
  id             String    @id @default(cuid())
  staff          StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId        String
  tokenHash      String    @unique
  ip             String?
  userAgent      String?
  /// Set once the session has cleared a TOTP challenge. Reveal-a-key and
  /// bulk-export both require a challenge newer than a few minutes.
  totpVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([staffId, revokedAt])
  @@schema("public")
}

/// Append-only, hash-chained. `hashPrev` links each row to its predecessor so
/// a silent deletion or edit in the middle of the chain is detectable.
model AuditLog {
  id        String     @id @default(cuid())
  actor     StaffUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  actorType ActorType  @default(STAFF)

  entity   String /// e.g. "Variant", "Promotion", "InventoryLevel"
  entityId String
  action   String /// e.g. "price.update", "promotion.create", "key.export"

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  hashPrev  String?
  hash      String   @unique
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@schema("public")
}
