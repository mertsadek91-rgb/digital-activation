{
  "name": "@da/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "format": "prisma format",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist generated .turbo",
    "build": "tsc -p tsconfig.build.json",
    "doctor": "tsx scripts/db-doctor.ts",
    "roles": "tsx scripts/setup-roles.ts",
    "import": "tsx scripts/import/index.ts",
    "media": "tsx scripts/media/index.ts",
    "staff": "tsx scripts/create-staff.ts",
    "pages": "tsx scripts/legacy/pages.ts",
    "seo": "tsx scripts/seo/index.ts",
    "seo-audit": "tsx scripts/seo/audit.ts",
    "written": "tsx scripts/seo/written/apply.ts",
    "short": "tsx scripts/seo/written/short.ts",
    "faq": "tsx scripts/seo/written/faq/apply.ts",
    "bodies": "tsx scripts/seo/bodies.ts",
    "demo": "tsx scripts/demo.ts",
    "redirects": "tsx scripts/legacy/redirects.ts",
    "articles": "tsx scripts/legacy/articles.ts",
    "article-links": "tsx scripts/legacy/article-links.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:",
    "argon2": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "fast-xml-parser": "catalog:",
    "prisma": "catalog:",
    "rimraf": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
