{
  "name": "digital-activation",
  "private": true,
  "version": "0.1.0",
  "description": "Digital Activation store — Next.js storefront + admin, NestJS API, PostgreSQL",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "env:check": "tsx scripts/env-check.ts",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "smtp:set": "tsx scripts/set-smtp.ts",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @da/db run generate",
    "db:roles": "pnpm --filter @da/db run roles",
    "db:urls": "tsx scripts/derive-db-urls.ts",
    "db:migrate": "pnpm --filter @da/db run migrate",
    "db:validate": "pnpm --filter @da/db run validate",
    "db:doctor": "pnpm --filter @da/db run doctor",
    "db:format": "pnpm --filter @da/db run format",
    "db:studio": "pnpm --filter @da/db run studio",
    "db:seed": "pnpm --filter @da/db run seed",
    "db:import": "pnpm --filter @da/db run import",
    "db:media": "pnpm --filter @da/db run media",
    "db:pages": "pnpm --filter @da/db run pages",
    "db:seo": "pnpm --filter @da/db run seo",
    "db:seo-audit": "pnpm --filter @da/db run seo-audit",
    "db:written": "pnpm --filter @da/db run written",
    "db:short": "pnpm --filter @da/db run short",
    "db:faq": "pnpm --filter @da/db run faq",
    "db:titles": "pnpm --filter @da/db run titles",
    "db:blog": "pnpm --filter @da/db run blog",
    "db:blog-expand": "pnpm --filter @da/db run blog-expand",
    "db:blog-new": "pnpm --filter @da/db run blog-new",
    "db:blog-fix": "pnpm --filter @da/db run blog-fix",
    "db:redirects": "pnpm --filter @da/db run redirects",
    "db:staff": "pnpm --filter @da/db run staff",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "tunnel": "tsx scripts/tunnel.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.3"
    }
  }
}
