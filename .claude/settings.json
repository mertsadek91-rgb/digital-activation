{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(**/.env)",
      "Read(./Old Website/**)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(./Old Website/**)",
      "Edit(./agent-os/state/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(pnpm prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(printenv:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(pnpm db:migrate:*)", "Bash(gh pr merge:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/metrics.mjs\"", "timeout": 5 }]
      }
    ]
  }
}
