# ===========================================================================
# Copy to .env and fill in. .env is gitignored — never commit real values.
# ===========================================================================

NODE_ENV=development
APP_ENV=local

# --- URLs -------------------------------------------------------------------
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000

# The API origin the browser talks to. Must be NEXT_PUBLIC_, because the admin
# panel calls it from the page rather than from the server — the session is a
# cookie the browser holds, not a token the server could forward.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The public origin the storefront believes it is serving. INDEXING IS DERIVED
# FROM THIS: anything other than exactly https://digital-activation.com gets
# noindex plus a blanket robots.txt disallow. That is what keeps the rebuild on
# new.digital-activation.com out of the index while the legacy site still holds
# the apex — two near-identical hostnames competing over the same content is a
# cost that outlasts the convenience.
# At cutover, set this to the apex and indexing switches on by itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# A brake for the window between cutover and being ready to be found.
SEO_BLOCK_INDEXING=false

# Lets the storefront request DRAFT products from the API. The storefront only
# sends it while running on a host that is not indexable, so a staging site
# shows work in progress and production shows published products only.
PREVIEW_TOKEN=

# --- Database ---------------------------------------------------------------
# Three roles on one database, on purpose. See docs/deployment.md.
#
# PERCENT-ENCODE THE PASSWORD. A Coolify-generated password often contains
# @ / : # + or a space, all of which are structural characters in a URL:
#   @ -> %40   / -> %2F   : -> %3A   # -> %23   + -> %2B   space -> %20
# `pnpm db:doctor` reports this case specifically.
#
# In Coolify use the INTERNAL service name as the host and sslmode=disable;
# publish a port only while running migrations from your own machine.

# Application role. NO grant on the `vault` schema — verified by db:doctor.
DATABASE_URL="postgresql://da_app:da_local_dev@localhost:5432/da_main?schema=public"
# Owner role. Used ONLY by `prisma migrate` / `prisma db push`.
DATABASE_URL_MIGRATE="postgresql://da:da_local_dev@localhost:5432/da_main?schema=public"
# Vault role. Injected ONLY into the API's licence-vault module.
DATABASE_URL_VAULT="postgresql://da_vault:da_local_dev@localhost:5432/da_main?schema=vault"

# One-time only: consumed by roles.prod.sql when creating the two roles on a
# managed database. Generate with `openssl rand -base64 32`. Not read by any
# application at runtime.
DA_APP_PASSWORD=
DA_VAULT_PASSWORD=

# --- Developing against the Coolify services --------------------------------
# `pnpm tunnel` forwards postgres, redis and meilisearch from the server's
# loopback interface to the same ports here, so development runs against the
# real services while none of them has a public port. Every URL below then
# stays on localhost — the same file works tunnelled or with `pnpm infra:up`.
# Requires each Coolify resource to bind 127.0.0.1:<port>:<port> in Ports
# Mappings rather than publish publicly.
TUNNEL_SSH_HOST=              # e.g. root@203.0.113.10

# --- Redis / queues / search ------------------------------------------------
REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=da_local_dev_master_key

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_min_32_chars_______________
JWT_REFRESH_SECRET=change_me_min_32_chars_______________
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_ISSUER="Digital Activation"

# --- Licence vault encryption -----------------------------------------------
# Envelope encryption: a per-row data key (AES-256-GCM) wrapped by a KEK.
#
# Production is AWS KMS, decided 2026-09-09. The KEK never leaves KMS: the app
# sends a data key to be wrapped and gets it back. A full compromise of the
# Coolify host therefore yields ciphertext and nothing that decrypts it.
# validateEnv REFUSES to boot with KEK_PROVIDER=local when NODE_ENV=production.
KEK_PROVIDER=local            # local (dev only) | aws-kms
KEK_LOCAL_BASE64=             # 32 raw bytes, base64. LOCAL DEV ONLY.

# The KMS key ARN or alias, e.g. arn:aws:kms:eu-central-1:123456789012:key/...
# or alias/digital-activation-vault
AWS_KMS_KEY_ID=
AWS_REGION=eu-central-1
# IAM credentials scoped to kms:Encrypt, kms:Decrypt, kms:GenerateDataKey and
# kms:DescribeKey on THAT KEY ARN ONLY — no wildcards, no other services.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bumped only when the KEK is rotated; every row records which generation
# wrapped it, so rotation is incremental rather than a re-encrypt of everything.
VAULT_KEY_VERSION=1

# --- Payments ---------------------------------------------------------------
# Verify Stripe accepts the Turkish entity + "software licences" category
# BEFORE building on it. Fallback: Paddle / Lemon Squeezy as Merchant of Record.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- Mail / notifications ---------------------------------------------------
# Transactional and marketing use SEPARATE domains so a marketing blast can
# never damage deliverability of a licence-key email.
# smtp (mailpit in dev) | resend (production) | capture (writes the rendered
# message to .cache/mail/ and sends nothing — for reading what a licence email
# actually says without mailing anyone). `capture` is refused when NODE_ENV is
# production, because a captured licence email is a plaintext key in a file.
MAIL_TRANSPORT=smtp
SMTP_URL="smtp://localhost:1025"
RESEND_API_KEY=
MAIL_FROM_TRANSACTIONAL="orders@digital-activation.com"
# The inbox a human reads: printed in every licence email and on the contact
# page, and where the contact form delivers. Not the same as the From address.
SUPPORT_EMAIL="help@digital-activation.com"
MAIL_FROM_MARKETING="news@mail.digital-activation.com"
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT="mailto:web@digital-activation.com"
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# --- Storage: Cloudflare R2 (decided 2026-09-09) ----------------------------
# S3-compatible with no egress fees, and media is the largest outbound cost in
# a store. Keeping images off the server disk also means a redeploy or a host
# migration cannot lose them.
S3_ENDPOINT=                  # https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=digital-activation-media
# R2 API token scoped to Object Read & Write on that bucket only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto                # R2 ignores region; "auto" is required
# Serve through a custom domain bound to the bucket, e.g.
# https://cdn.digital-activation.com — the r2.dev development URL is rate
# limited and unsuitable for production. Must also be listed in the storefront's
# next.config.ts images.remotePatterns or <Image> will refuse to optimise it.
#
# Object keys resolve against this as a relative URL, so if it carries a path
# it needs a trailing slash: ".../media/" keeps the segment, ".../media" drops
# it and every image 404s from the bucket root. An origin with no path is fine
# either way. Leave it empty and the API serves keys under /media/ instead.
S3_PUBLIC_BASE_URL=

# Salt for the vault's duplicate-detection fingerprints. A licence key has low
# entropy in practice — suppliers issue them in blocks — so an unsalted digest
# column would let anyone holding the table confirm a guess. Same value for
# every row on purpose: that is what lets the unique index catch a duplicate.
# Changing it makes existing fingerprints unmatchable, so set it once.
VAULT_FINGERPRINT_SALT=
# KEK generation stamped on new rows. Bump it only alongside a re-wrap.
KEK_VERSION=1

# --- Pricing ----------------------------------------------------------------
BASE_CURRENCY=USD
FX_PROVIDER=exchangerate-host
FX_API_KEY=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
