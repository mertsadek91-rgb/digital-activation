# ===========================================================================
# Copy to .env and fill in. .env is gitignored — never commit real values.
# ===========================================================================

NODE_ENV=development
APP_ENV=local

# --- URLs -------------------------------------------------------------------
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000

# --- Database ---------------------------------------------------------------
# Three roles on one database, on purpose. See docs/deployment.md.
#
# PERCENT-ENCODE THE PASSWORD. A Coolify-generated password often contains
# @ / : # + or a space, all of which are structural characters in a URL:
#   @ -> %40   / -> %2F   : -> %3A   # -> %23   + -> %2B   space -> %20
# `pnpm db:doctor` reports this case specifically.
#
# In Coolify use the INTERNAL service name as the host and sslmode=disable;
# publish a port only while running migrations from your own machine.

# Application role. NO grant on the `vault` schema — verified by db:doctor.
DATABASE_URL="postgresql://da_app:da_local_dev@localhost:5432/da_main?schema=public"
# Owner role. Used ONLY by `prisma migrate` / `prisma db push`.
DATABASE_URL_MIGRATE="postgresql://da:da_local_dev@localhost:5432/da_main?schema=public"
# Vault role. Injected ONLY into the API's licence-vault module.
DATABASE_URL_VAULT="postgresql://da_vault:da_local_dev@localhost:5432/da_main?schema=vault"

# One-time only: consumed by roles.prod.sql when creating the two roles on a
# managed database. Generate with `openssl rand -base64 32`. Not read by any
# application at runtime.
DA_APP_PASSWORD=
DA_VAULT_PASSWORD=

# --- Redis / queues / search ------------------------------------------------
REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=da_local_dev_master_key

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_min_32_chars_______________
JWT_REFRESH_SECRET=change_me_min_32_chars_______________
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_ISSUER="Digital Activation"

# --- License vault encryption ----------------------------------------------
# Envelope encryption: per-key DEK (AES-256-GCM) wrapped by a KEK held in KMS.
# In production KEK_PROVIDER=aws-kms and the raw key never exists in env.
KEK_PROVIDER=local            # local | aws-kms | vault
KEK_LOCAL_BASE64=             # 32 raw bytes, base64. LOCAL DEV ONLY.
AWS_KMS_KEY_ID=
AWS_REGION=eu-central-1
VAULT_KEY_VERSION=1

# --- Payments ---------------------------------------------------------------
# Verify Stripe accepts the Turkish entity + "software licences" category
# BEFORE building on it. Fallback: Paddle / Lemon Squeezy as Merchant of Record.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- Mail / notifications ---------------------------------------------------
# Transactional and marketing use SEPARATE domains so a marketing blast can
# never damage deliverability of a licence-key email.
MAIL_TRANSPORT=smtp           # smtp (mailpit in dev) | resend | ses
SMTP_URL="smtp://localhost:1025"
RESEND_API_KEY=
MAIL_FROM_TRANSACTIONAL="orders@digital-activation.com"
MAIL_FROM_MARKETING="news@mail.digital-activation.com"
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT="mailto:web@digital-activation.com"
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# --- Storage ----------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=digital-activation-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# --- Pricing ----------------------------------------------------------------
BASE_CURRENCY=USD
FX_PROVIDER=exchangerate-host
FX_API_KEY=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
